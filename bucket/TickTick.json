    },
    "architecture": {
        "64bit": {
            "url": "https://cdn.dida365.cn/download/win64/dida_win_setup_release_x64_8136.exe",
            "hash": "8bb41fac693d383f85b4b779739a7a0951d108dbd1cc9bae95b32e8ac937cf40"
        },
        "32bit": {
            "url": "https://cdn.dida365.cn/download/win/dida_win_setup_release_x86_8136.exe",
            "hash": "95764e3f1630d086cd755eda6bfd7be2c97f240b1c291bd8202e04d32c08b84a"
        }
    },
    "innosetup": true,
    "shortcuts": [
        [
            "TickTick.exe",
            "滴答清单"
        ]
    ],
    "pre_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name air) scripts/AirUtils.psm1)",
        "RedirectDirectory \"$env:APPDATA\\Tick_Tick\" \"$persist_dir\\APPDATA\\Tick_Tick\"",
        "Remove-Module -Name AirUtils"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name air) scripts/AirUtils.psm1)",
            "    RemoveJunction \"$env:APPDATA\\Tick_Tick\"",
            "    Remove-Module -Name AirUtils",
            "}"
        ]
    },
    "checkver": {
        "url": "https://pull.dida365.com/windows/release_note.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.dida365.cn/download/win64/dida_win_setup_release_x64_$cleanVersion.exe"
            },
            "32bit": {
                "url": "https://cdn.dida365.cn/download/win/dida_win_setup_release_x86_$cleanVersion.exe"
            }
        }
    }
}
