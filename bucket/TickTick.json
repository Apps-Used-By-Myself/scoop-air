    },
    "architecture": {
        "64bit": {
            "url": "https://cdn.dida365.cn/download/win64/dida_win_setup_release_x64_8135.exe",
            "hash": "95064f9bb97b8b4c1992e1d2f625fb1f0a17ed9e75a0f6cc070b39a3227c920f"
        },
        "32bit": {
            "url": "https://cdn.dida365.cn/download/win/dida_win_setup_release_x86_8135.exe",
            "hash": "c5e514e181f8046fff21167998ae64a2d0d90e6eb1724142f4c18351cc6c7707"
        }
    },
    "innosetup": true,
    "shortcuts": [
        [
            "TickTick.exe",
            "滴答清单"
        ]
    ],
    "pre_install": [
        "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name air) scripts/AirUtils.psm1)",
        "RedirectDirectory \"$env:APPDATA\\Tick_Tick\" \"$persist_dir\\APPDATA\\Tick_Tick\"",
        "Remove-Module -Name AirUtils"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name air) scripts/AirUtils.psm1)",
            "    RemoveJunction \"$env:APPDATA\\Tick_Tick\"",
            "    Remove-Module -Name AirUtils",
            "}"
        ]
    },
    "checkver": {
        "url": "https://pull.dida365.com/windows/release_note.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.dida365.cn/download/win64/dida_win_setup_release_x64_$cleanVersion.exe"
            },
            "32bit": {
                "url": "https://cdn.dida365.cn/download/win/dida_win_setup_release_x86_$cleanVersion.exe"
            }
        }
    }
}
